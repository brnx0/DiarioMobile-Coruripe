# Servidor
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=debug

# Banco de dados (SQL Server)
DATABASE_URL="sqlserver://HOST:1433;database=DATABASE_NAME;user=DATABASE_USER;password=DATABASE_PASSWORD;trustServerCertificate=true;encrypt=false"

# JWT
JWT_ACCESS_SECRET=troque-este-secret-com-32-chars-random
JWT_REFRESH_SECRET=outro-secret-diferente-com-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=*
