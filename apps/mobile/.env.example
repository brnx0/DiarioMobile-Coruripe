# URL base da API. Em dispositivo fisico, troque localhost pelo IP da maquina.
EXPO_PUBLIC_URL_API="http://localhost:3000"
EXPO_PUBLIC_SYS_COD="?sys=CDM"

# Apenas desenvolvimento. Nunca habilitar em builds de producao.
EXPO_PUBLIC_ALLOW_INSECURE_HTTP="true"

# Whitelabel: nome do municipio exibido na tela de login (vazio = oculto)
EXPO_PUBLIC_MUNICIPALITY_NAME="MUNICIPIO"

# Mostrar logo do municipio (assets/LogoMunicipio.png) no rodape do login
EXPO_PUBLIC_SHOW_MUNICIPALITY_LOGO="false"
